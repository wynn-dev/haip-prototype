# Copy to .env.local and fill in. One DB + one deployment for the prototype.
# Locally, leaving DATABASE_URL empty falls back to embedded Postgres (PGlite in ./.pglite).

# ── Neon Postgres ──────────────────────────────────────────────
# Neon console → your project → Connect → "Pooled connection" string
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ── Auth ───────────────────────────────────────────────────────
# Any long random string: `openssl rand -base64 32`
AUTH_SECRET=""

# ── Cloudflare R2 (photo uploads) ──────────────────────────────
# Leave empty locally to store uploads in public/uploads instead.
# R2 → Manage API tokens → Object Read & Write on the bucket.
# Bucket needs a CORS rule allowing PUT from your site origin, and public access
# (r2.dev subdomain or custom domain) for R2_PUBLIC_URL.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""   # e.g. https://pub-xxxx.r2.dev
# Either S3 keys above OR the signed-upload worker (workers/r2-upload) below:
R2_UPLOAD_WORKER_URL=""  # e.g. https://haip-r2-upload.<subdomain>.workers.dev
R2_UPLOAD_SECRET=""      # same value as the worker's UPLOAD_SECRET secret

# ── Optional ───────────────────────────────────────────────────
# Set once a real SMS/e-mail provider is wired up; until then codes are shown in-app ("DEMO").
SMS_PROVIDER_KEY=""
# Trusted-reporter prioritisation in the moderation queue (default on)
PRIORITISE_TRUSTED_REPORTERS="true"
